# Server-only credentials from an Upstash Redis database.
# Never prefix these names with NEXT_PUBLIC_.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional. Defaults to grade-calculator:<VERCEL_ENV or NODE_ENV> so production,
# preview, and local totals stay separate. Changing this starts a new counter.
# USAGE_COUNTER_NAMESPACE=grade-calculator:production
